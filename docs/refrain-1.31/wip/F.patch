---
 src/fileImportPdf.ts      | 6 ++++--
 src/v131-notebook.test.ts | 5 ++---
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/src/fileImportPdf.ts b/src/fileImportPdf.ts
index 6094cf0..0b68c76 100644
--- a/src/fileImportPdf.ts
+++ b/src/fileImportPdf.ts
@@ -844,8 +844,10 @@ export function pdfToMarkdown(bytes: Uint8Array): PdfResult {
   const markdown = linesToMarkdown(perPage);
   const letters = markdown.replace(/[^\p{L}\p{N}]/gu, '').length;
   const warnings: string[] = [];
-  const isScan = letters < pages.length * 40;
-  if (isScan && unreadable && !scans.length) throw new Error('Текст в этом PDF набран шрифтом без таблицы символов — прочитать его нельзя. Открой PDF и сохрани как .docx (Word умеет) или «Печать → Сохранить как PDF».');
+  // Скан: текста почти нет, а на страницах — большие картинки.
+  const isScan = letters < pages.length * 40 && scans.length > 0;
+  if (!letters && !scans.length && !unreadable) throw new Error('В PDF не нашлось ни текста, ни снимков страниц.');
+  if (!letters && unreadable && !scans.length) throw new Error('Текст в этом PDF набран шрифтом без таблицы символов — прочитать его нельзя. Открой PDF и сохрани как .docx (Word умеет) или «Печать → Сохранить как PDF».');
   if (!isScan && unreadable) warnings.push('Часть текста набрана шрифтом без таблицы символов и пропущена.');
   return { markdown: isScan ? '' : markdown, stats: { tables: 0, images, pages: pages.length }, warnings, scans: isScan ? scans : [] };
 }
diff --git a/src/v131-notebook.test.ts b/src/v131-notebook.test.ts
index de8e302..2305687 100644
--- a/src/v131-notebook.test.ts
+++ b/src/v131-notebook.test.ts
@@ -279,12 +279,11 @@ describe('файл: PDF без сторонних библиотек', () => {
     const jpeg = (r.scans[0] as { bytes: Uint8Array }).bytes;
     expect([jpeg[0], jpeg[1], jpeg[2]]).toEqual([0xff, 0xd8, 0xff]);
   });
-  it('ToUnicode с bfrange (обе формы), двухбайтные коды, перенос слова, TJ с пробелом', () => {
+  it('ToUnicode с bfrange (обе формы), двухбайтные коды, строки абзаца склеиваются, TJ со сдвигом — пробел', () => {
     const cmap = '/CIDInit /ProcSet findresource begin 12 dict begin begincmap 1 begincodespacerange <0000> <FFFF> endcodespacerange 2 beginbfrange <0001> <0003> <0444> <0010> <0011> [<043E> <0442>] endbfrange 1 beginbfchar <0020> <0020> endbfchar endcmap end end';
-    // ф ф х — о т: «фф» + перенос «х-» и пробел через TJ
     const text = 'BT /F1 12 Tf 72 700 Td [<00010002> -400 <0010>] TJ 0 -14 Td <00110003> Tj ET';
     const r = pdfToMarkdown(page('<< /Type /Font /Subtype /Type0 /BaseFont /X /Encoding /Identity-H /ToUnicode 6 0 R /DescendantFonts [7 0 R] >>', { dict: '', data: text, flate: true }, [`<< /Length ${cmap.length} >>\nstream\n${cmap}\nendstream`, '<< /Type /Font /Subtype /CIDFontType2 /DW 500 >>']));
-    expect(r.markdown).toBe('фх о\n\nтц'.replace('\n\n', ' '));
+    expect(r.markdown).toBe('фх о тц');
   });
   it('простой шрифт: Differences с именами кириллицы и старый cp1251 без кодировки', () => {
     const diff = pdfToMarkdown(page('<< /Type /Font /Subtype /Type1 /BaseFont /Times /Encoding << /Differences [65 /afii10017 /afii10066 /space /uni0436] >> >>', { dict: '', data: 'BT /F1 12 Tf 10 10 Td (ABCD) Tj ET' }));
