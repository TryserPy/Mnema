+      }
+    });
+    parts.push(`trailer\n<< ${trailer} >>\n%%EOF`);
+    const bytes = parts.map((x) => (typeof x === 'string' ? strToU8(x, true) : x));
+    const out = new Uint8Array(bytes.reduce((n, b) => n + b.length, 0));
+    let off = 0;
+    for (const b of bytes) (out.set(b, off), (off += b.length));
+    return out;
+  };
