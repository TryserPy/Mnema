+    const parts: (string | Uint8Array)[] = ['%PDF-1.7\n'];
+    objs.forEach((o, i) => {
+      if (typeof o === 'string') parts.push(`${i + 1} 0 obj\n${o}\nendobj\n`);
+      else {
+        const raw = typeof o.data === 'string' ? strToU8(o.data, true) : o.data;
+        const data = o.flate ? zlibSync(raw) : raw;
