<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет-список («Домашка», «Уроки»): заголовок, строки и кнопка внизу. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/wl_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/w_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/wl_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/w_muted"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/wl_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/w_ink2"
        android:textSize="13sp"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/wl_btn"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:background="@drawable/widget_btn"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:textStyle="bold" />
</LinearLayout>
