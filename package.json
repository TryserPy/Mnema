{
  "name": "mnema",
  "productName": "Refrain",
  "version": "1.28.0",
  "description": "Refrain — приложение для запоминания учебного материала",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "test": "vitest run",
    "preview": "vite preview",
    "preview:web": "vite preview --mode web --outDir dist-web",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb tar.gz --x64 --publish never",
    "dist:linux:arm64": "npm run build && electron-builder --linux AppImage deb tar.gz --arm64 --publish never",
    "icons:linux": "node scripts/linux-icons.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/d3-force": "^3.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "jsqr": "^1.4.0",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "mathlive": "^0.110.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "author": "Refrain",
  "homepage": "https://tryserpy.github.io/Mnema-site/",
  "desktopName": "refrain.desktop",
  "build": {
    "appId": "app.mnema.study",
    "productName": "Refrain",
    "publish": [
      {
        "provider": "github",
        "owner": "TryserPy",
        "repo": "Mnema",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "package.json",
      "!node_modules/tesseract.js/dist/**",
      "!node_modules/tesseract.js/docs/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons",
      "executableName": "refrain",
      "syncDesktopName": true,
      "category": "Education",
      "packageCategory": "education",
      "maintainer": "Refrain <noreply@users.noreply.github.com>",
      "vendor": "Refrain",
      "synopsis": "Refrain — запоминать учебный материал и повторять с перерывами",
      "description": "Refrain — приложение для запоминания учебного материала: конспект, карточки и повторения по расписанию (FSRS). Всё хранится на компьютере, интернет и аккаунт не нужны.",
      "artifactName": "Refrain-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Refrain",
          "GenericName": "Study cards",
          "GenericName[ru]": "Учебные карточки",
          "Comment[en]": "Remember what you study: notes, flashcards and spaced repetition",
          "Comment[ru]": "Запоминай учебный материал: конспект, карточки и повторения по расписанию",
          "Keywords": "flashcards;study;memory;spaced repetition;fsrs;anki;school;notes;",
          "Keywords[ru]": "карточки;учёба;запоминание;повторение;школа;конспект;экзамен;анки;",
          "StartupWMClass": "refrain"
        }
      },
      "fileAssociations": [
        {
          "ext": "mnema",
          "name": "Тема Refrain",
          "description": "Тема Refrain",
          "mimeType": "application/x-refrain-topic"
        },
        {
          "ext": "refrainstyle",
          "name": "Стиль Refrain",
          "description": "Стиль оформления Refrain",
          "mimeType": "application/x-refrain-style"
        },
        {
          "ext": "mnemamod",
          "name": "Стиль Refrain (старый)",
          "description": "Стиль оформления Refrain (старый формат)",
          "mimeType": "application/x-mnema-style"
        }
      ]
    },
    "appImage": {
      "artifactName": "Refrain-${version}-${arch}.AppImage"
    },
    "deb": {
      "packageName": "refrain",
      "artifactName": "Refrain_${version}_${arch}.deb",
      "priority": "optional"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Refrain",
      "uninstallDisplayName": "Refrain",
      "artifactName": "Refrain-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    },
    "extraResources": [
      {
        "from": "ocr-data",
        "to": "ocr-data"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/webidl-conversions/**",
      "node_modules/opencollective-postinstall/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**"
    ]
  },
  "dependencies": {
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "electron-updater": "^6.8.9",
    "tesseract.js": "^7.0.0"
  }
}
